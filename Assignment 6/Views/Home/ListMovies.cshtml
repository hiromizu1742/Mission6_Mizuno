@model IEnumerable<Assignment_6.Models.Movies>

@{
    ViewData["Title"] = "Movie List";
}

<h1 class="display-6 mb-3">All Movies</h1>

<table class="table table-striped table-bordered">
    <thead class="table-light">
    <tr>
        <th>Category</th>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Copied To Plex</th>
        <th>Lent To</th>
        <th>Notes</th>
        <th></th>
    </tr>
    </thead>
    <tbody class="fw-bold">
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Category?.CategoryName</td>
            <td>@movie.Title</td>
            <td>@movie.Year</td>
            <td>@movie.Director</td>
            <td>@movie.Rating</td>
            <td>@(movie.Edited == 1 ? "Yes" : "No")</td>
            <td>@(movie.CopiedToPlex == 1 ? "Yes" : "No")</td>
            <td>@movie.LentTo</td>
            <td>@movie.Notes</td>
            <td><a class="btn btn-light" asp-controller="Home" asp-action="Edit" asp-route-id="@movie.MovieId">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
